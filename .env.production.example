# =====================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# Parroquia Nuestra Señora de la Encarnación
# =====================================================
# IMPORTANTE: Copiar este archivo a .env en producción
# y ajustar los valores según el servidor.
# =====================================================

# --- APLICACIÓN ---
APP_NAME="Parroquia Nuestra Señora de la Encarnación"
APP_ENV=production
APP_KEY=  # Generar con: php artisan key:generate
APP_DEBUG=false  # CRÍTICO: Debe ser false en producción
APP_URL=https://parroquiaencarnaciontampico.org
APP_TIMEZONE=America/Mexico_City

# --- IDIOMA ---
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# --- SEGURIDAD ---
BCRYPT_ROUNDS=12
SESSION_SECURE_COOKIE=true  # Solo HTTPS
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
SESSION_DOMAIN=.parroquiaencarnaciontampico.org

# --- BASE DE DATOS ---
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=  # Nombre de la BD en cPanel
DB_USERNAME=  # Usuario de BD en cPanel
DB_PASSWORD=  # Contraseña de BD

# --- CACHÉ Y SESIONES ---
CACHE_STORE=file  # O 'redis' si está disponible
SESSION_DRIVER=file  # O 'database' para mayor persistencia
QUEUE_CONNECTION=database

# --- ALMACENAMIENTO ---
FILESYSTEM_DISK=public

# --- EMAIL (SMTP) ---
MAIL_MAILER=smtp
MAIL_HOST=  # Servidor SMTP (ej: mail.parroquiaencarnaciontampico.org)
MAIL_PORT=465
MAIL_USERNAME=  # Email completo (ej: contacto@parroquiaencarnaciontampico.org)
MAIL_PASSWORD=  # Contraseña del email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contacto@parroquiaencarnaciontampico.org"
MAIL_FROM_NAME="Parroquia de la Encarnación"

# --- LOGS ---
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error  # Solo errores en producción
LOG_DEPRECATIONS_CHANNEL=null

# --- VITE ---
VITE_APP_NAME="${APP_NAME}"

# =====================================================
# CHECKLIST DE SEGURIDAD ANTES DE LANZAR
# =====================================================
# [ ] APP_DEBUG=false
# [ ] APP_KEY generada (php artisan key:generate)
# [ ] SESSION_SECURE_COOKIE=true
# [ ] SSL/HTTPS configurado
# [ ] Permisos de archivos correctos (755 dirs, 644 files)
# [ ] storage/ y bootstrap/cache/ con permisos de escritura
# [ ] .env NO accesible públicamente
# [ ] Backups de BD configurados
# [ ] Cron job para queue:work
# =====================================================
